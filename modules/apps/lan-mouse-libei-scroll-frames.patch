+//! Select one scroll representation per libei device frame.
+use reis::event::{Device, EiEvent};
+
+use crate::{Event, PointerEvent};
+
+/// Stateful capture conversion. Keep one instance per EIS connection.
+pub struct EiFrameConverter {
+    scroll: ScrollFrames<Device>,
+}
+
+impl Default for EiFrameConverter {
+    fn default() -> Self {
+        Self { scroll: ScrollFrames::default() }
+    }
+}
+
+impl EiFrameConverter {
+    pub fn clear(&mut self) {
+        self.scroll.pending.clear();
+    }
+
+    pub fn convert(&mut self, event: EiEvent) -> Vec<Event> {
+        match &event {
+            EiEvent::ScrollDelta(scroll) => {
+                let device = scroll.device.clone();
+                self.buffer(device, event);
+                Vec::new()
+            }
+            EiEvent::ScrollDiscrete(scroll) => {
+                let device = scroll.device.clone();
+                self.buffer(device, event);
+                Vec::new()
+            }
+            EiEvent::Frame(frame) => self.scroll
+                .finish(&frame.device, (frame.time / 1000) as u32)
+                .into_iter().map(Event::Pointer).collect(),
+            EiEvent::DeviceRemoved(e) => {
+                self.scroll.remove(&e.device);
+                Vec::new()
+            }
+            EiEvent::DevicePaused(e) => {
+                self.scroll.remove(&e.device);
+                Vec::new()
+            }
+            EiEvent::DeviceStopEmulating(e) => {
+                self.scroll.remove(&e.device);
+                Vec::new()
+            }
+            EiEvent::DeviceStartEmulating(e) => {
+                self.scroll.remove(&e.device);
+                Vec::new()
+            }
+            EiEvent::SeatRemoved(_) | EiEvent::Disconnected(_) => {
+                self.clear();
+                Vec::new()
+            }
+            _ => Event::from_ei_event(event).collect(),
+        }
+    }
+
+    fn buffer(&mut self, device: Device, event: EiEvent) {
+        for event in Event::from_ei_event(event) {
+            if let Event::Pointer(pointer) = event {
+                self.scroll.push(device.clone(), pointer);
+            }
+        }
+    }
+}
+
+// Device only implements PartialEq. The number of active scrolling devices is small.
+struct ScrollFrames<K> {
+    pending: Vec<(K, Vec<PointerEvent>)>,
+}
+
+impl<K> Default for ScrollFrames<K> {
+    fn default() -> Self {
+        Self { pending: Vec::new() }
+    }
+}
+
+impl<K: PartialEq> ScrollFrames<K> {
+    fn push(&mut self, device: K, event: PointerEvent) {
+        if let Some((_, events)) = self.pending.iter_mut().find(|(key, _)| *key == device) {
+            events.push(event);
+        } else {
+            self.pending.push((device, vec![event]));
+        }
+    }
+
+    fn remove(&mut self, device: &K) -> Vec<PointerEvent> {
+        self.pending.iter().position(|(key, _)| key == device)
+            .map(|index| self.pending.swap_remove(index).1)
+            .unwrap_or_default()
+    }
+
+    fn finish(&mut self, device: &K, time: u32) -> Vec<PointerEvent> {
+        let events = self.remove(device);
+        // Presence, not the sum: opposite discrete movements may cancel within a frame.
+        let discrete = [0, 1].map(|axis| events.iter().any(|event| matches!(
+            event, PointerEvent::AxisDiscrete120 { axis: a, value } if *a == axis && *value != 0
+        )));
+        events.into_iter().filter_map(|event| match event {
+            PointerEvent::Axis { axis, .. } if discrete[axis as usize] => None,
+            PointerEvent::Axis { axis, value, .. } =>
+                Some(PointerEvent::Axis { time, axis, value }),
+            event => Some(event),
+        }).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn smooth(axis: u8, value: f64) -> PointerEvent {
+        PointerEvent::Axis { time: 0, axis, value }
+    }
+
+    fn wheel(axis: u8, value: i32) -> PointerEvent {
+        PointerEvent::AxisDiscrete120 { axis, value }
+    }
+
+    #[test]
+    fn recorded_wheel_pair_is_forwarded_once_in_either_order() {
+        for value in [120, -120, 15, -30] {
+            for reverse in [false, true] {
+                let mut frames = ScrollFrames::default();
+                let mut events = [smooth(0, value as f64 / 8.), wheel(0, value)];
+                if reverse { events.reverse(); }
+                for event in events { frames.push(1, event); }
+                assert_eq!(frames.finish(&1, 42), vec![wheel(0, value)]);
+                assert!(frames.finish(&1, 43).is_empty());
+            }
+        }
+    }
+
+    #[test]
+    fn touchpad_and_mixed_axes_keep_continuous_scroll_and_timestamp() {
+        let mut frames = ScrollFrames::default();
+        frames.push(1, smooth(0, 2.5));
+        frames.push(1, smooth(1, -3.25));
+        frames.push(1, wheel(0, 24));
+        assert_eq!(frames.finish(&1, 42), vec![
+            PointerEvent::Axis { time: 42, axis: 1, value: -3.25 }, wheel(0, 24),
+        ]);
+        frames.push(1, smooth(0, 1.5));
+        assert_eq!(frames.finish(&1, 43), vec![
+            PointerEvent::Axis { time: 43, axis: 0, value: 1.5 },
+        ]);
+    }
+
+    #[test]
+    fn devices_and_frames_are_independent() {
+        let mut frames = ScrollFrames::default();
+        frames.push(1, smooth(0, 15.));
+        frames.push(2, wheel(0, 120));
+        assert_eq!(frames.finish(&2, 10), vec![wheel(0, 120)]);
+        assert_eq!(frames.finish(&1, 11), vec![
+            PointerEvent::Axis { time: 11, axis: 0, value: 15. },
+        ]);
+        frames.push(2, smooth(0, 1.));
+        assert_eq!(frames.finish(&2, 12), vec![
+            PointerEvent::Axis { time: 12, axis: 0, value: 1. },
+        ]);
+    }
+
+    #[test]
+    fn cancellation_does_not_restore_duplicate_continuous_events() {
+        let mut frames = ScrollFrames::default();
+        for event in [smooth(0, 15.), wheel(0, 120), smooth(0, -15.), wheel(0, -120)] {
+            frames.push(1, event);
+        }
+        assert_eq!(frames.finish(&1, 1), vec![wheel(0, 120), wheel(0, -120)]);
+    }
+
+    #[test]
+    fn removed_devices_and_capture_reset_discard_pending_scroll() {
+        let mut frames = ScrollFrames::default();
+        frames.push(1, smooth(0, 15.));
+        frames.push(2, wheel(0, 120));
+        frames.remove(&1);
+        assert!(frames.finish(&1, 1).is_empty());
+        assert_eq!(frames.finish(&2, 1), vec![wheel(0, 120)]);
+        frames.push(2, wheel(0, 120));
+        frames.pending.clear();
+        assert!(frames.finish(&2, 2).is_empty());
+    }
+}
